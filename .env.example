# Copia este archivo a .env y completa los valores. .env no se sube a git.

# Base de datos (ejecucion local / Supabase). En Docker Compose, DB_URL lo define el compose.
DB_URL=jdbc:postgresql://localhost:5432/comercial_hibrido
DB_USERNAME=comercial
DB_PASSWORD=cambia-esta-clave

# Solo para Docker Compose (contenedor PostgreSQL)
POSTGRES_DB=comercial_hibrido
POSTGRES_USER=comercial
POSTGRES_PASSWORD=cambia-esta-clave

SERVER_PORT=8084

OPENAI_API_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=pon-aqui-tu-clave
OPENAI_MODEL=openai/gpt-oss-20b

WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=pon-aqui-el-phone-number-id
WHATSAPP_ACCESS_TOKEN=pon-aqui-el-token-de-meta
WHATSAPP_WEBHOOK_VERIFY_TOKEN=crea-un-token-largo
# Obligatorio: sin el, el webhook responde 403 a todo.
WHATSAPP_APP_SECRET=pon-aqui-el-app-secret-de-meta

# Secreto para firmar los JWT del panel (minimo 32 caracteres aleatorios).
AGENT_JWT_SECRET=genera-uno-con-openssl-rand-base64-48

# Dueños de la plataforma (correos separados por coma): ven las solicitudes de demo de la landing.
PLATFORM_ADMIN_EMAILS=tu@correo.com
# WhatsApp de ventas para el botón de la landing (formato internacional). Vacío = sin botón.
SALES_WHATSAPP=

PANEL_ALLOWED_ORIGINS=https://panel.tudominio.com
AGENT_MAX_ATTEMPTS=5
AGENT_RETRY_BASE_SECONDS=10
AGENT_STALE_JOB_MINUTES=10
AGENT_WORKER_FIXED_DELAY_MS=1000
